# ── R2 / S3-compatible object storage (own bucket; read creds go on-chain) ──
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=

# ── Bittensor wallet ──
BT_WALLET_NAME=default
BT_WALLET_HOTKEY=default
BT_NETWORK=test            # finney for mainnet
BT_NETUID=0

# ── Optional telemetry ──
WANDB_API_KEY=
HF_TOKEN=                  # step A downloads; step F/H uploads

# Set by the blessed container; enforced against the manifest at startup.
MOK_CONTAINER_DIGEST=
